# ===== Web app =====
# Mật khẩu đăng nhập web app quản lý
APP_PASSWORD=doi-mat-khau-nay
# Chuỗi bí mật ký cookie phiên (đặt chuỗi ngẫu nhiên dài)
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai
# Tên miền cho HTTPS khi chạy trên VPS (vd: 135-125-75-93.sslip.io hoặc tiktok.tenmien.com)
DOMAIN=
# Token Cloudflare Tunnel (nếu dùng docker-compose.tunnel.yml)
CLOUDFLARE_TUNNEL_TOKEN=
# URL công khai của web app (dùng làm redirect URI cho TikTok OAuth)
BASE_URL=http://localhost:8000
# Đường dẫn file SQLite
DATABASE_PATH=data/tiktok.db
# Múi giờ dùng để phân tích giờ đăng tốt nhất
TIMEZONE=Asia/Ho_Chi_Minh

# ===== TikTok for Developers (Login Kit + Display API) =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ===== Quét định kỳ =====
# Số giờ giữa 2 lần quét (có thể đổi trên web app)
SCAN_INTERVAL_HOURS=6
# Số video tối đa lấy mỗi lần quét
MAX_VIDEOS_PER_SCAN=200

# ===== Gemini (lên chiến lược) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cổng gọi Gemini: aistudio (generativelanguage) | vertex (Vertex AI, tính tiền qua Google Cloud Billing)
GEMINI_BACKEND=aistudio
# Tự động tạo chiến lược mới sau mỗi lần quét (true/false)
AUTO_STRATEGY=false

# ===== Đồng bộ NotebookLM =====
# Chế độ: drive | enterprise | local | off   (có thể kết hợp bằng dấu phẩy: drive,local)
NOTEBOOKLM_MODE=local
# Thư mục xuất file Markdown (chế độ local) - tải thủ công lên NotebookLM
EXPORT_DIR=exports
# File JSON của Google Service Account (dùng cho drive & enterprise)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# --- Chế độ drive: Google Docs làm nguồn cho NotebookLM ---
# Tạo sẵn 2 Google Docs, chia sẻ quyền Editor cho email service account, dán ID vào đây
GOOGLE_DOC_ID_REPORT=
GOOGLE_DOC_ID_STRATEGY=

# --- Chế độ enterprise: NotebookLM Enterprise API (Google Cloud) ---
NOTEBOOKLM_PROJECT_NUMBER=
NOTEBOOKLM_LOCATION=global
NOTEBOOKLM_NOTEBOOK_ID=
